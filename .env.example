# postgres-app — non-sensitive variables
# POSTGRES_* are the source of truth: generate postgres-app/.env (chmod 600,
# gitignored) with scripts/vault-secrets.sh. DATABASE_URL is mirrored into
# Vault secret/postgres-app/dev and regenerated by scripts/gen-env.sh.
# NEVER commit postgres-app/.env.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=your_own_strong_password_here
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# pgAdmin (non-secret defaults; the generated .env sets the real values)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_own_strong_password_here
PGADMIN_PORT=8080
