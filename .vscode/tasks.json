{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "validate stack",
      "type": "shell",
      "command": "make validate",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "compose: check config",
      "type": "shell",
      "command": "docker compose -f compose.yml -p postgres-app config --quiet",
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "shellcheck: scripts",
      "type": "shell",
      "command": "shellcheck scripts/*.sh",
      "problemMatcher": ["$shellcheck"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "make up",
      "type": "shell",
      "command": "make up",
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "make down",
      "type": "shell",
      "command": "make down",
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "make ps",
      "type": "shell",
      "command": "make ps",
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "make logs",
      "type": "shell",
      "command": "make logs",
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "make snapshot",
      "type": "shell",
      "command": "make snapshot",
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
